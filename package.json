{
  "name": "coral",
  "version": "0.2.14",
  "private": true,
  "description": "General-purpose graph visualization and diagram tooling",
  "workspaces": [
    "packages/language",
    "packages/render",
    "packages/browser",
    "packages/viz",
    "packages/diagram-editor",
    "packages/mcp-server",
    "packages/tree-sitter-coral"
  ],
  "scripts": {
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:minimum-runtime": "node scripts/check-toolchain.mjs --minimum-runtime",
    "test:toolchain": "node --test scripts/check-toolchain.test.mjs",
    "test:session-start-hook": "node --test scripts/session-start-hook.test.mjs",
    "test:fuzz:extended": "node scripts/fuzz-model.mjs --target=all --cases=128 --max-size=512 --timeout-ms=60000",
    "test:route-robustness": "node scripts/route-robustness.mjs",
    "test:e2e:robustness": "playwright test --config playwright.robustness.config.ts",
    "test:e2e:robustness:pairwise": "playwright test e2e/acceptance028-pairwise-source-owned.spec.ts --config playwright.robustness.config.ts",
    "test:inherited-consumers": "npm run test:run -w @coral-viz/diagram-editor -- test/useEditorController.test.tsx test/sequenceController.test.tsx && node scripts/inherited-consumers.mjs",
    "clean": "npm run clean --workspaces --if-present && npm run clean:static",
    "build": "npm run build:public && npm run build -w @coral-viz/diagram-editor",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test:run --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "verify": "node scripts/ci-local.mjs",
    "test:e2e": "playwright test",
    "test:e2e:performance": "playwright test --config playwright.performance.config.ts",
    "test:e2e:on-device": "playwright test --config playwright.onDevice.config.ts",
    "test:performance": "npm run test:performance:language && npm run test:performance:render && npm run test:performance:viz && npm run test:performance:editor && npm run test:e2e:performance",
    "test:performance:language": "npm exec -w @coral-viz/language -- vitest run --config vitest.benchmark.config.ts",
    "test:performance:render": "npm exec -w @coral-viz/render -- vitest run --config vitest.benchmark.config.ts",
    "test:performance:editor": "npm exec -w @coral-viz/diagram-editor -- vitest run --config vitest.benchmark.config.ts",
    "test:coverage:gate": "npm run test:coverage -w @coral-viz/viz && npm run test:coverage -w @coral-viz/mcp-server && npm run test:coverage -w @coral-viz/diagram-editor -- --maxWorkers=2",
    "audit:fragments": "knip --config knip.json --no-progress --include files,exports,types,nsExports,nsTypes,dependencies,devDependencies,unlisted,unresolved,duplicates",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "smoke:api-compat-consumers": "node scripts/api-compat-consumers.mjs",
    "test:api-compat": "node --test scripts/api-compat.test.mjs",
    "test:clean": "node --test scripts/clean.test.mjs",
    "test:offline-retirement": "node --test scripts/offline-retirement.test.mjs",
    "clean:static": "node scripts/clean.mjs build",
    "build:online": "node scripts/online-delivery.mjs build",
    "verify:online": "node scripts/online-delivery.mjs verify",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "test:online-delivery": "node --test scripts/online-delivery.test.mjs",
    "test:online-delivery:integration": "node --test scripts/online-delivery.integration.test.mjs",
    "test:canvas-creation-contract": "node --test scripts/canvas-creation-contract.test.mjs",
    "test:release-version": "node --test scripts/release-version.test.mjs",
    "test:release-closure": "node --test scripts/packed-package.test.mjs scripts/release-closure.test.mjs scripts/candidate-artifacts.test.mjs scripts/ci-final-candidate.test.mjs scripts/github-release-guard.test.mjs scripts/cdn-readback.test.mjs scripts/release-notes.test.mjs scripts/pages-restore.test.mjs scripts/release-workflow-steps.test.mjs scripts/workspace-audit.test.mjs scripts/npm-command.test.mjs scripts/renderer-candidate-config.test.mjs",
    "audit:dependencies": "node scripts/workspace-audit.mjs --ci",
    "test:release-controls": "node --test scripts/release-controls.test.mjs scripts/release-readiness.test.mjs scripts/braces-risk.test.mjs",
    "test:gitleaks": "node --test scripts/gitleaks.test.mjs",
    "check:gitleaks": "gitleaks detect --no-git --redact --config .gitleaks.toml --source .",
    "check:browser-canary": "node scripts/browser-canary.mjs",
    "check:github-auth-preflight": "node scripts/github-auth-preflight.mjs",
    "test:workflow-policy": "node --test scripts/workflow-policy.test.mjs",
    "check:workflow-policy": "node scripts/workflow-policy.mjs",
    "test:language-spec": "node --test scripts/language-spec.test.mjs",
    "check:language-spec": "node scripts/verify-language-spec.mjs",
    "test:coral-corpus": "node --test scripts/coral-corpus.test.mjs",
    "test:graphir-adoption": "node --test scripts/graphir-adoption.test.mjs scripts/consumer-generation.test.mjs scripts/verify-local-successor-bridge.test.mjs",
    "test:local-successor-bridge": "node scripts/verify-local-successor-bridge.mjs",
    "check:graphir-adoption": "node scripts/verify-graphir-adoption.mjs",
    "api-compat": "npm run test:api-compat && npm run test:graphir-adoption && npm run typecheck",
    "smoke:native": "node scripts/native-smoke.mjs",
    "check:docs": "node scripts/check-docs-structure.mjs && node --test scripts/library-docs.test.mjs scripts/contributor-docs.test.mjs scripts/markdown-corpus.test.mjs scripts/documentation-examples.test.mjs && node scripts/check-markdown-links.mjs",
    "lint:md": "markdownlint-cli2",
    "test:markdownlint": "node --test tools/markdownlint/",
    "test:library-docs": "node --test scripts/library-docs.test.mjs",
    "test:contributor-docs": "node --test scripts/contributor-docs.test.mjs",
    "test:capability-truth": "node --test scripts/capability-truth.test.mjs",
    "build:public": "npm run build -w @coral-viz/language && npm run build -w @coral-viz/render && npm run build -w @coral-viz/browser && npm run build -w @coral-viz/viz && npm run build -w @coral-viz/mcp-server",
    "docs:api": "npm run build:public && node scripts/api-docs.mjs",
    "test:api-docs": "node --test --test-isolation=none scripts/api-docs.test.mjs scripts/api-docs-build.test.mjs",
    "prepare:typecheck": "npm run build:public && npm run typecheck",
    "test:fuzz": "node scripts/fuzz-model.mjs --target=all --cases=12 --max-size=96 --timeout-ms=10000",
    "ci:source": "node scripts/ci.mjs source",
    "ci:packages": "node scripts/ci.mjs packages",
    "ci:hydrate": "node scripts/ci.mjs hydrate",
    "ci:site": "node scripts/ci.mjs site",
    "ci:restore-site": "node scripts/ci.mjs restore-site",
    "ci:browser-prepare": "node scripts/ci.mjs browser-prepare",
    "ci:windows-risk": "node scripts/ci.mjs windows-risk",
    "ci:contracts": "node scripts/ci.mjs contracts",
    "ci:unit": "node scripts/ci.mjs unit",
    "ci:windows-unit": "node scripts/ci.mjs windows-unit",
    "ci:native": "node scripts/ci.mjs native",
    "ci:delivery": "node scripts/ci.mjs delivery",
    "docs:api:prepared": "node scripts/api-docs.mjs",
    "test:performance:viz": "npm exec -w @coral-viz/viz -- vitest run --config vitest.benchmark.config.ts",
    "check:icons": "node scripts/check-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "ajv": "8.20.0",
    "eslint": "10.11.0",
    "knip": "6.37.0",
    "markdownlint-cli2": "0.23.3",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitepress": "1.6.4",
    "yaml": "2.9.1"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "sharp": "0.35.5",
    "ajv": "8.20.0",
    "vitepress": {
      "@docsearch/css": "5.1.0",
      "@docsearch/js": "5.1.0",
      "vite": "6.4.5"
    },
    "eslint": {
      "ajv": "6.15.0"
    },
    "markdownlint-cli2": {
      "smol-toml": "1.9.1",
      "markdown-it": "15.0.3"
    },
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "tree-sitter": true,
    "tree-sitter-cli": true,
    "tree-sitter-coral": true
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "npm@12.0.2"
}
