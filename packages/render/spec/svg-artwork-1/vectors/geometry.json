{
  "profile": {
    "id": "coral.svg-artwork",
    "version": "1"
  },
  "status": "final",
  "vectors": [
    {
      "id": "geometry-nonfinite-path",
      "description": "A path coordinate that overflows binary64 is refused.",
      "covers": [
        "nonfinite:path"
      ],
      "input": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M0 0L1e999 0\"/></svg>",
      "expect": {
        "result": "refused",
        "codes": [
          "coral.artwork.svg.geometry.invalid"
        ]
      }
    },
    {
      "id": "geometry-nonfinite-rect",
      "description": "A non-finite size is refused.",
      "covers": [
        "nonfinite:attribute"
      ],
      "input": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><rect width=\"1e400\" height=\"1\"/></svg>",
      "expect": {
        "result": "refused",
        "codes": [
          "coral.artwork.svg.geometry.invalid"
        ]
      }
    },
    {
      "id": "geometry-nonfinite-transform",
      "description": "A non-finite transform argument is refused.",
      "covers": [
        "nonfinite:transform"
      ],
      "input": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><g transform=\"scale(1e309)\"><path d=\"M0 0H1\"/></g></svg>",
      "expect": {
        "result": "refused",
        "codes": [
          "coral.artwork.svg.geometry.invalid"
        ]
      }
    },
    {
      "id": "geometry-nan-token",
