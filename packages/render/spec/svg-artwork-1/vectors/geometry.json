        "inputIsCanonical": false,
        "canonical": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1000000000 1000000000\">\n  <path d=\"M 0 0 L 1000000000 0\" fill=\"#000000\" stroke=\"none\" stroke-width=\"1\" opacity=\"1\"/>\n</svg>\n"
      }
    },
