      "covers": [
        "malicious:javascript-url"
      ],
      "input": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><set attributeName=\"href\" to=\"javascript:alert(1)\"/></svg>",
      "expect": {
        "result": "refused",
        "codes": [
          "coral.artwork.svg.element.unsupported"
        ]
      }
    },
    {
      "id": "malicious-attribute-quote-breakout",
      "description": "An escaped quote inside a value cannot add an attribute.",
      "covers": [
        "malicious:attribute-breakout"
      ],
      "input": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M0 0H1\" fill=\"&quot; onload=&quot;alert(1)\"/></svg>",
      "expect": {
        "result": "refused",
        "codes": [
          "coral.artwork.svg.attribute.unsupported"
        ]
      }
    },
    {
      "id": "malicious-nul-in-attribute",
      "description": "A NUL character in an attribute.",
      "covers": [
        "malicious:control-character"
      ],
      "input": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M0 0H1\" fill=\"red\u0000; onload=alert(1)\"/></svg>",
      "expect": {
        "result": "refused",
        "codes": [
          "coral.artwork.svg.parse"
        ]
      }
    },
    {
      "id": "malicious-deep-nesting",
      "description": "5,000 nested groups stop at depth 33 while parsing.",
      "covers": [
        "malicious:deep-nesting"
      ],
      "inputParts": [
        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">",
        {
          "repeat": "<g>",
          "count": 5000
        },
        {
          "repeat": "</g>",
          "count": 5000
        },
        "</svg>"
      ],
      "expect": {
        "result": "refused",
        "codes": [
          "coral.artwork.svg.budget.exceeded"
        ],
        "budgets": [
          "nesting"
        ]
      }
    },
    {
      "id": "malicious-raw-block-terminator",
      "description": "A line of exactly three double quotes in a comment and in desc text never reaches canonical text.",
      "covers": [
        "malicious:raw-block-terminator"
      ],
      "input": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n<!--\n\"\"\"\n-->\n<desc>\n\"\"\"\n</desc>\n<path d=\"M0 0H1\"/>\n</svg>\n",
      "expect": {
        "result": "admitted",
        "tier": "standard",
        "inputIsCanonical": false,
        "canonical": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n  <path d=\"M 0 0 H 1\" fill=\"#000000\" stroke=\"none\" stroke-width=\"1\" opacity=\"1\"/>\n</svg>\n"
      }
    }
  ]
}
