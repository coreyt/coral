      ],
      "input": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><use href=\"https://evil.example/s.svg#x\"/></svg>",
      "expect": {
        "result": "refused",
        "codes": [
          "coral.artwork.svg.element.unsupported"
        ]
      }
    },
