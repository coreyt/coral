          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ClassifierCompartment"
          }
        }
      },
      "allOf": [
        {
          "properties": {
            "compartments": {
              "contains": {
                "properties": { "kind": { "const": "name" } },
                "required": ["kind"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["class", "interface"] } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "compartments": {
                "allOf": [
                  {
                    "contains": { "properties": { "kind": { "const": "attributes" } }, "required": ["kind"] },
                    "minContains": 0,
                    "maxContains": 1
                  },
                  {
                    "contains": { "properties": { "kind": { "const": "operations" } }, "required": ["kind"] },
                    "minContains": 0,
                    "maxContains": 1
                  },
                  {
                    "not": {
                      "contains": { "properties": { "kind": { "const": "literals" } }, "required": ["kind"] }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "enum" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "compartments": {
                "allOf": [
                  {
                    "contains": { "properties": { "kind": { "const": "literals" } }, "required": ["kind"] },
                    "minContains": 1,
                    "maxContains": 1
                  },
                  {
                    "contains": { "properties": { "kind": { "const": "operations" } }, "required": ["kind"] },
                    "minContains": 0,
                    "maxContains": 1
                  },
                  {
                    "not": {
                      "contains": { "properties": { "kind": { "const": "attributes" } }, "required": ["kind"] }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
