@diagram flowchart
@coralVersion "0.2.9"
@conformanceLevel strict
@symbol tick {
  name "Tick"
  size 16 x 16
  artwork svg """
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path d="M2 8 L6 12 L14 4"/></svg>
"""
}
check process [symbol: "local.tick"] as "Check"
choose decision
check -> choose
