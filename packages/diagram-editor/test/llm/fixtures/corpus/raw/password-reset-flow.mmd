flowchart TD
    User((User))
    ResetForm[Password Reset Request]
    AuthService[Auth Service]
    TokenStore[(Reset Token Store)]
    EmailService[Email Service]
    NewPasswordForm[New Password Form]

    User -->|submits email address| ResetForm
    ResetForm -->|request reset token| AuthService
    AuthService -->|store token| TokenStore
    AuthService -->|send reset email| EmailService
    EmailService -->|deliver reset link| User
    User -->|submits new password| NewPasswordForm
