@diagram uml-class
Airline class as "Airline" {
  attributes = attributes {
    attribute_1 = public attribute name: String
    attribute_2 = public attribute iataCode: String
  }
}
Flight class as "Flight" {
  attributes = attributes {
    attribute_1 = public attribute flightNumber: String
    attribute_2 = public attribute departureTime: DateTime
  }
}
Aircraft class as "Aircraft" {
  attributes = attributes {
    attribute_1 = public attribute tailNumber: String
    attribute_2 = public attribute model: String
  }
}
Route class as "Route" {
  attributes = attributes {
    attribute_1 = public attribute routeCode: String
    attribute_2 = public attribute distanceKm: int
  }
}
Airport class as "Airport" {
  attributes = attributes {
    attribute_1 = public attribute code: String
    attribute_2 = public attribute city: String
  }
}
Passenger class as "Passenger" {
  attributes = attributes {
    attribute_1 = public attribute name: String
    attribute_2 = public attribute passportNumber: String
  }
}
Reservation class as "Reservation" {
  attributes = attributes {
    attribute_1 = public attribute confirmationCode: String
    attribute_2 = public attribute status: String
  }
}
Ticket class as "Ticket" {
  attributes = attributes {
    attribute_1 = public attribute ticketNumber: String
    attribute_2 = public attribute fare: Decimal
  }
}
Seat class as "Seat" {
  attributes = attributes {
    attribute_1 = public attribute seatNumber: String
    attribute_2 = public attribute cabinClass: String
  }
}
BoardingPass class as "BoardingPass" {
  attributes = attributes {
    attribute_1 = public attribute gate: String
    attribute_2 = public attribute boardingTime: DateTime
  }
}
Payment class as "Payment {
  attributes = attributes {
    attribute_1 = public attribute amount: Decimal
    attribute_2 = public attribute method: String
  }
}
Itinerary class as "Itinerary" {
  attributes = attributes {
    attribute_1 = public attribute itineraryId: String
    attribute_2 = public attribute legCount: int
  }
}
CrewMember class as "CrewMember" {
  attributes = attributes {
    attribute_1 = public attribute name: String
    attribute_2 = public attribute role: String
  }
}
LoyaltyAccount class as "LoyaltyAccount" {
  attributes = attributes {
    attribute_1 = public attribute memberId: String
    attribute_2 = public attribute pointsBalance: int
  }
}

rel_1 = Airline -- Flight [composition, firstEnd: filledDiamond]
rel_2 = Flight --> Aircraft [association] as "uses"
rel_3 = Flight --> Route [association] as "follows"
rel_4 = Route --> Airport [association] as "origin"
rel_5 = Route --> Airport [association] as "destination"
rel_6 = Passenger --> Reservation [association] as "makes"
rel_7 = Reservation --> Flight [association] as "booked on"
rel_8 = Reservation -- Ticket [composition, firstEnd: filledDiamond]
rel_9 = Ticket --> Seat [association] as "assigned"
rel_10 = Ticket --> BoardingPass [association] as "generates"
rel_11 = Reservation --> Payment [association] as "paid via"
rel_12 = Passenger --> Itinerary [association] as "receives"
rel_13 = Itinerary -- Reservation [composition, firstEnd: filledDiamond]
rel_14 = Flight -- CrewMember [aggregation, firstEnd: diamond]
rel_15 = Passenger --> LoyaltyAccount [association] as "enrolled in"
