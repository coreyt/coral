@diagram architecture
@coralVersion "0.2.9"

@symbol gateway {
  name "Gateway"
  size 48 x 48
  outline diamond
  out port [direction: out, anchor: E, label: "Out", maxConnections: 2]
  artwork svg """
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"><path d="M24 4L44 24L24 44L4 24Z" fill="#157580"/></svg>
"""
}

ingress service [symbol: "local.gateway"] as "Gateway"
api service as "API"
ingress:out -> api
