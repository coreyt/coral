{
  "name": "@coral-viz/browser",
  "version": "0.2.15",
  "description": "Render Coral diagram source to accessible SVG in an ordinary web page, as an ES module or a self-contained script, with no React or editor dependency",
  "homepage": "https://coreyt.github.io/coral/",
  "bugs": {
    "url": "https://github.com/coreyt/coral/issues"
  },
  "keywords": [
    "coral",
    "diagram",
    "diagrams-as-code",
    "svg",
    "browser",
    "web-component",
    "custom-element",
    "flowchart",
    "sequence-diagram"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreyt/coral.git",
    "directory": "packages/browser"
  },
  "type": "module",
  "main": "dist/coral-browser.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/coral-browser.js"
    },
    "./iife": "./dist/coral-browser.iife.js",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/coral-browser.iife.js",
  "jsdelivr": "./dist/coral-browser.iife.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean.mjs dist && node ../../scripts/clean.mjs build",
    "build": "node ../../scripts/clean.mjs dist && node ../../scripts/clean.mjs build && tsc && node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "@graph-ir/core": "0.2.4"
  },
  "devDependencies": {
    "@coral-viz/language": "0.2.15",
    "@coral-viz/render": "0.2.15",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "jsdom": "30.1.0",
    "rolldown": "1.2.7",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
